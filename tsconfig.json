{
  "compilerOptions": {
    /* =========================
       Language & Environment
    ========================= */
    "target": "ES2022",
    "lib": ["ES2022"],
     "module": "NodeNext",
    "moduleResolution": "NodeNext",
    

    /* =========================
       Directories
    ========================= */
    "rootDir": ".",
    "outDir": "./dist",

    /* =========================
       Type Safety
    ========================= */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,

    /* =========================
       Module Handling
    ========================= */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* =========================
       Build Optimization
    ========================= */
    "removeComments": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,

    /* =========================
       Decorators
    ========================= */
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,

    /* =========================
       Type Definitions
    ========================= */
    "types": ["node", "jest"],

    /* =========================
       Path Aliases
    ========================= */
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@config/*": ["config/*"],
      "@modules/*": ["modules/*"],
      "@shared/*": ["shared/*"],
      "@core/*": ["core/*"],
      "@middlewares/*": ["middlewares/*"],
      "@database/*": ["database/*"],
      "@utils/*": ["utils/*"]
    },

    /* =========================
       Consistency
    ========================= */
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* =========================
       Output
    ========================= */
    "pretty": true,
    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
